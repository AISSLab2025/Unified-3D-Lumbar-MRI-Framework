{
    "model": {
        "base_dim": 12,
        "curve": "hilbert",
        "d_conv": 2,
        "d_state": 8,
        "depth": 3,
        "expand": 2,
        "in_channels": 1,
        "out_channels": 4,
        "return_aux": false,
        "sequence_kernel": 7,
        "use_anatomy_gating": true,
        "use_backward_mamba": true,
        "use_forward_mamba": true,
        "variant": "binary_aghm"
    },
    "threshold": 0.5,
    "class_names": {
        "0": "Background",
        "1": "PE",
        "2": "TS",
        "3": "AAP",
        "4": "IVD"
    }
}
